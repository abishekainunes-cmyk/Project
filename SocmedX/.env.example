# ==============================================================================
# NUNES Social Media Command Center — Environment Variables Template
# Copy this file to .env.local for local development.
# ==============================================================================

# Core Application URL
PUBLIC_APP_URL="https://nunes-social-post-machine-mu.vercel.app"
NUNES_UPSTREAM_URL="https://nunes-social-post-machine-mu.vercel.app"

# Multi-Node Shared State & AES-256-GCM Storage Bridge
SOCIAL_STATE_BRIDGE_URL="https://your-persistent-storage-bridge.com/api/state"
SOCIAL_STATE_BRIDGE_SECRET="your-shared-bridge-secret-key"
SOCIAL_STATE_ENCRYPTION_KEY="your-aes-256-encryption-key-minimum-32-chars"

# Meta Graph API (Facebook Page & Instagram Professional)
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_CONFIG_ID="your-meta-configuration-id"
FACEBOOK_PAGE_ID="1398853319976762"
INSTAGRAM_ACCOUNT_ID="17841422933669789"

# LinkedIn Developer API (REST v2)
LINKEDIN_CLIENT_ID="your-linkedin-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-client-secret"
LINKEDIN_AUTHOR_URN="urn:li:organization:your-org-id"

# WhatsApp Business Cloud API (WABA)
WHATSAPP_WABA_ID="3603262783168599"
WHATSAPP_PHONE_NUMBER_ID="1398853319976762"
WHATSAPP_ACCESS_TOKEN="your-whatsapp-system-user-token"

# YouTube / Google Developer API
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Server-Side Scheduled Cron Worker Engine
CRON_SECRET="your-secure-cron-secret-token"

# Optional Cloud Media Storage (S3 / Cloudinary / Blob)
SOCIAL_UPLOAD_API_URL=""
SOCIAL_STATE_SHARED_SECRET=""
